# ==============================================================================
# 启煊软件智能体 (Qixuan Agent) 环境变量配置模板 (.env.example)
# 使用说明: 请复制本文件为 .env (cp .env.example .env) 并填入真实凭证，严禁将 .env 提交至 Git 仓库
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hugging Face 模型与推理平台凭证 (核心必选)
# 获取地址: https://huggingface.co/settings/tokens (需开启 Make calls to Inference Providers 权限)
# ------------------------------------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_ORG_NAME=qixuan-software

# ------------------------------------------------------------------------------
# 2. 企业即时通讯网关凭证 (按需启用对应通道)
# ------------------------------------------------------------------------------
# 2.1 飞书 (Feishu / Lark) 机器人应用凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2.2 钉钉 (DingTalk) 企业内部机器人凭证
DINGTALK_CLIENT_ID=dingxxxxxxxxxxxxxxxx
DINGTALK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2.3 企业微信 (WeCom) 自建应用凭证
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_AGENT_ID=1000002
WECOM_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WECOM_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
WECOM_ENCODING_AES_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. 研发与代码仓库集成凭证 (GitLab / GitHub / Jira)
# ------------------------------------------------------------------------------
GIT_INTERNAL_URL=https://git.qixuan-soft.internal
GIT_SKILL_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GIT_REVIEWER_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GIT_WEBHOOK_SECRET=qx_wh_sec_xxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. 运维监控与只读观测接口凭证 (Prometheus / ELK / Grafana)
# ------------------------------------------------------------------------------
PROMETHEUS_ENDPOINT=http://prometheus.qixuan-soft.internal:9090
PROMETHEUS_READONLY_TOKEN=qx_prom_ro_xxxxxxxxxxxxxxxx
ELK_ENDPOINT=http://elasticsearch.qixuan-soft.internal:9200
ELK_READONLY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. 内网私有化 GPU 推理节点配置 (涉密项目开启 --profile confidential 时生效)
# ------------------------------------------------------------------------------
LOCAL_VLLM_API_KEY=qx-local-vllm-secret-key-2026
LOCAL_VLLM_HOST=http://local-vllm-confidential:8000/v1

# ------------------------------------------------------------------------------
# 6. 通知与值班告警 Webhook
# ------------------------------------------------------------------------------
OPS_ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DEV_TEAM_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
